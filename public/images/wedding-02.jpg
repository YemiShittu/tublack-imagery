<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a1830"/>
      <stop offset="50%" stop-color="#091424"/>
      <stop offset="100%" stop-color="#050c17"/>
    </linearGradient>
    <radialGradient id="vignette" cx="50%" cy="50%" r="60%">
      <stop offset="50%" stop-color="#000000" stop-opacity="0"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.8"/>
    </radialGradient>
    <pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="0.7" fill="#fff" opacity="0.04"/>
      <circle cx="70" cy="40" r="0.8" fill="#fff" opacity="0.03"/>
      <circle cx="45" cy="80" r="0.6" fill="#fff" opacity="0.05"/>
      <circle cx="85" cy="15" r="0.5" fill="#fff" opacity="0.03"/>
      <circle cx="10" cy="65" r="0.7" fill="#fff" opacity="0.04"/>
    </pattern>
  </defs>

  <!-- Background base -->
  <rect width="600" height="800" fill="url(#bg)"/>
  
  <!-- Subtle photographic framing & golden ratio lines -->
  <line x1="198" y1="0" x2="198" y2="800" stroke="#38bdf8" stroke-width="0.5" opacity="0.08"/>
  <line x1="396" y1="0" x2="396" y2="800" stroke="#38bdf8" stroke-width="0.5" opacity="0.08"/>
  <line x1="0" y1="264" x2="600" y2="264" stroke="#38bdf8" stroke-width="0.5" opacity="0.08"/>
  <line x1="0" y1="528" x2="600" y2="528" stroke="#38bdf8" stroke-width="0.5" opacity="0.08"/>
  
  <!-- Film Grain Pattern -->
  <rect width="600" height="800" fill="url(#grain)"/>

  <!-- Center Framing Elements -->
  <rect x="30" y="30" width="540" height="740" fill="none" stroke="#38bdf8" stroke-width="1" opacity="0.2"/>
  <rect x="40" y="40" width="520" height="720" fill="none" stroke="#ffffff" stroke-width="0.5" opacity="0.1"/>

  <!-- Crosshair viewfinder markers -->
  <path d="M 40 55 L 40 40 L 55 40" fill="none" stroke="#38bdf8" stroke-width="1.5" opacity="0.8"/>
  <path d="M 545 40 L 560 40 L 560 55" fill="none" stroke="#38bdf8" stroke-width="1.5" opacity="0.8"/>
  <path d="M 40 745 L 40 760 L 55 760" fill="none" stroke="#38bdf8" stroke-width="1.5" opacity="0.8"/>
  <path d="M 545 760 L 560 760 L 560 745" fill="none" stroke="#38bdf8" stroke-width="1.5" opacity="0.8"/>

  <!-- Icon Graphic -->
  
    <rect x="260" y="370" width="80" height="60" rx="10" fill="none" stroke="#38bdf8" stroke-width="2" opacity="0.6"/>
    <circle cx="300" cy="400" r="18" fill="none" stroke="#38bdf8" stroke-width="2.5" opacity="0.8"/>
    <circle cx="300" cy="400" r="8" fill="#38bdf8" opacity="0.3"/>
    <rect x="280" y="360" width="20" height="10" rx="3" fill="#38bdf8" opacity="0.5"/>
  

  <!-- Vignette -->
  <rect width="600" height="800" fill="url(#vignette)"/>

  <!-- Bottom Editorial Typography Overlay -->
  <rect x="0" y="690" width="600" height="110" fill="url(#bg)" opacity="0.95"/>
  <line x1="40" y1="690" x2="560" y2="690" stroke="#38bdf8" stroke-width="0.8" opacity="0.4"/>

  <text x="50" y="720" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="600" letter-spacing="3" fill="#38bdf8" text-transform="uppercase">Weddings · LAGOS</text>
  <text x="50" y="752" font-family="'Cormorant Garamond', Georgia, serif" font-size="24" font-weight="600" fill="#f8fafc">The Yoruba Engagement</text>
  <text x="50" y="774" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" fill="#94a3b8">Rich Aso-Ebi, coral beads & royal heritage</text>

  <!-- Tublack Stamp with signature style -->
  <text x="550" y="755" text-anchor="end" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="700" letter-spacing="2" fill="#ffffff">TuBLack</text>
  <text x="550" y="772" text-anchor="end" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" letter-spacing="4" fill="#38bdf8">IMAGERY</text>
</svg>